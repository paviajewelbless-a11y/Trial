      allow delete: if canWriteOperations(userId) && isValidId(orderId);
      allow create: if canWriteOperations(userId) && isValidId(orderId) &&
                       incoming().userId == userId &&
                       incoming().keys().hasAll(['userId', 'orderCode', 'orderDate', 'dueDate', 'productName', 'orderedBags', 'bagWeightKg', 'totalWeightKg', 'dispatchedWeightKg', 'customer', 'status', 'createdAt', 'updatedAt']) &&
